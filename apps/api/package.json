{
  "name": "@coinfidant/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:role": "docker compose -f ../../docker-compose.yml exec -T db psql -U coinfidant -d coinfidant -v pw=\"$APP_DB_PASSWORD\" -f - < scripts/create-app-role.sql",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@coinfidant/contracts": "*",
    "@coinfidant/engine": "*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
