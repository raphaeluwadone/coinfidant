NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173

# The API connects as the restricted app role; migrations run as the owner.
DATABASE_URL=postgres://coinfidant_app:CHANGE_ME@localhost:5433/coinfidant
MIGRATION_DATABASE_URL=postgres://coinfidant:coinfidant_local@localhost:5433/coinfidant
APP_DB_PASSWORD=CHANGE_ME

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
